# Copy of the variable names that `bin/penpot init` writes into the real .env.
# Placeholders only: never put a real secret in this file.

# Penpot release. MUST be exactly 2.18.4 (floating tags are rejected by `bin/penpot check`).
PENPOT_VERSION=2.18.4

# Fixed project name so Docker volume names stay stable (penpot_penpot_postgres_v15, penpot_penpot_assets).
COMPOSE_PROJECT_NAME=penpot

# Host ports. Both are published on 127.0.0.1 only.
PENPOT_HTTP_PORT=9001
PENPOT_MAIL_PORT=8025

# Secrets: `bin/penpot init` generates random values for these.
PENPOT_SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me
